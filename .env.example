# Copy to .env and fill in the required values. Never commit .env.

# Required settings
# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Your GCP project id (BigQuery queries on the public dataset are billed here).
# Authenticate first with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=

# Optional settings supported by the current prototype (defaults shown)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Maximum bytes billed per BigQuery query (1 GB).
BQ_MAX_BYTES_BILLED=1000000000

# Maximum SQL attempts per question, including failed or blocked queries.
MAX_SQL_ATTEMPTS=5

# Reports and traces directory, relative to the project root.
DATA_DIR=.data

# Additional settings present in the local .env, but NOT read by this prototype.
# Kept commented out for reference; uncommenting them will not enable features.

# Embeddings and Vertex AI are not configured through these variables.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_USE_VERTEX=false

# Explicit BigQuery location is not configured through this variable.
# BQ_LOCATION=US

# Use MAX_SQL_ATTEMPTS above instead of MAX_SQL_CALLS_PER_TURN.
# There is no separate SQL repair limit.
# MAX_SQL_CALLS_PER_TURN=6
# MAX_SQL_REPAIRS=2

# Cost estimates are not calculated from these variables.
# PRICE_INPUT_PER_M=0.30
# PRICE_OUTPUT_PER_M=2.50

# Langfuse tracing and managed prompts are not integrated.
# Leave credentials blank in this example.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
# LANGFUSE_PERSONA_PROMPT=

# Use DATA_DIR above instead of this older setting name.
# RETAIL_AGENT_DATA_DIR=.data
